+      p.start = buf.data() + halo.z * ch.xy_pitch + halo.y * ch.haloed.x + halo.x;
+      p.nx = ch.owned.x;
+      p.ny = ch.owned.y;
+      p.nz = ch.owned.z;
+      p.row_stride = ch.haloed.x;
+      p.plane_pitch = ch.xy_pitch;
+      p.comp_stride = per_comp;
+      pieces.push_back(p);
+    }
