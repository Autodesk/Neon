+template <typename T>
+auto
+vtk_roundtrip_case(const VtkCase& c,
+                   int comps,
+                   std::vector<int>& cover,
+                   size_t& shards,
+                   size_t& empty_shards,
+                   size_t& points) -> void {
+  g_ctx = std::string("part D ") + c.name + " T" + std::to_string(sizeof(T)) + " c" +
+          std::to_string(comps);
