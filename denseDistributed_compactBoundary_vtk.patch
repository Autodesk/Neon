+      for (int64_t y = 0; y < ch.haloed.y; ++y) {
+        for (int64_t x = 0; x < ch.haloed.x; ++x) {
+          const bool in_owned = x >= halo.x && x < halo.x + ch.owned.x && y >= halo.y &&
