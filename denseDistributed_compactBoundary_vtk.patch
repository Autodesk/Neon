+      bool threw = false;
+      carbon::log::set_level(spdlog::level::off);  // the library logs the (expected) rejection
+      try {
+        vtk::parse_vtk_box_header(in2, "mem", other, recs2);
+      } catch (const std::invalid_argument&) {
