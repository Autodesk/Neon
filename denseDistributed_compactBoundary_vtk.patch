+  /** Owned-local cell of linear shell index @p t in [0, bands.total); x varies fastest. */
+  [[nodiscard]] CARBON_HD constexpr auto
+  shell_cell_(const ShellBands& b,
+              int64_t t) const noexcept -> int64_3d {
+    const int64_3d n = logic_extent();
+    int box = 0;
+    while (box < 5 && t >= b.vol[box]) {
+      t -= b.vol[box];
+      ++box;
+    }
+    int64_t bx = 0;  // box origin
+    int64_t by = 0;
+    int64_t bz = 0;
+    int64_t w = n.x;  // box XY footprint
+    int64_t h = n.y;
+    switch (box) {
+      case 0:
+        break;
+      case 1:
+        bz = n.z - b.hi.z;
+        break;
+      case 2:
+        bz = b.lo.z;
+        h = b.lo.y;
+        break;
+      case 3:
+        by = n.y - b.hi.y;
+        bz = b.lo.z;
+        h = b.hi.y;
+        break;
+      case 4:
+        by = b.lo.y;
+        bz = b.lo.z;
+        w = b.lo.x;
+        h = n.y - b.lo.y - b.hi.y;
+        break;
+      default:
+        bx = n.x - b.hi.x;
+        by = b.lo.y;
+        bz = b.lo.z;
+        w = b.hi.x;
+        h = n.y - b.lo.y - b.hi.y;
+        break;
+    }
+    const int64_t x = t % w;
+    const int64_t r = t / w;
+    return int64_3d{bx + x, by + r % h, bz + r / h};
+  }
 };
 
