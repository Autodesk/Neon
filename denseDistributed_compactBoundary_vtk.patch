+// Injective for extents < 16 and up to 3 components, and it fits in int16.
+auto
+vtk_value(int64_t x,
+          int64_t y,
+          int64_t z,
+          int c) -> int {
+  return static_cast<int>(x + 16 * y + 256 * z + 4096 * c);
