# Multi-Python wheel builder: same as wheel-builder but with Python 3.11–3.14.
# Use with build-wheels-multi.sh to produce wheels for all supported versions.
# Base image and setup match Dockerfile.wheel-builder up to Python installs.
#
# BASE_IMAGE is overridden by build-run-docker-multi.sh based on host architecture:
#   x86_64:  nvidia/cuda:12.8.1-devel-ubuntu22.04  (default)
#   aarch64: nvidia/cuda:12.6.3-devel-ubuntu22.04  (Jetson driver supports up to 12.6)

ARG BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# System deps + deadsnakes for multiple Pythons
RUN apt-get update && apt-get install -y \
    software-properties-common \
    build-essential \
    cmake \
    git \
    ninja-build \
    gcc-11 \
    g++-11 \
    libomp-dev \
    pkg-config \
    wget \
    curl \
    sudo \
    python3.10 \
    python3.10-dev \
    python3-pip \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    python3.13 \
    python3.13-dev \
    python3.13-venv \
    python3.14 \
    python3.14-dev \
    python3.14-venv \
    && rm -rf /var/lib/apt/lists/*

# Builder user
RUN groupadd --gid 1000 builder \
    && useradd --uid 1000 --gid builder --shell /bin/bash --create-home builder \
    && usermod -aG sudo builder \
    && echo 'builder ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/builder \
    && chmod 0440 /etc/sudoers.d/builder

# GCC 11 as default
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 100 \
    && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-11 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-11 100

# Default `python`/`pip` point to 3.10 (for scripts that expect them)
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python 2>/dev/null || true
RUN python3.10 -m pip install --upgrade pip setuptools wheel build \
    && (ln -sf /usr/local/bin/pip /usr/bin/pip 2>/dev/null || true)

# Bootstrap pip for deadsnakes Pythons that don't ship with a working pip.
RUN python3.11 -m ensurepip --upgrade \
    && python3.12 -m ensurepip --upgrade \
    && python3.13 -m ensurepip --upgrade \
    && python3.14 -m ensurepip --upgrade

# Pip + build deps for every Python version
RUN for py in 3.10 3.11 3.12 3.13 3.14; do \
    python$py -m pip install --upgrade pip setuptools wheel build; \
    python$py -m pip install numpy pytest pybind11; \
    done

WORKDIR /workspace
RUN chown builder:builder /workspace 2>/dev/null || true
USER builder
CMD ["/bin/bash"]
