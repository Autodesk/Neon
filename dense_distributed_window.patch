+    }
+  }
+
+  [[nodiscard]] CARBON_HD constexpr auto
+  total_volume() const noexcept -> int64_t {
+    int64_t v = 0;
+    for (int i = 0; i < count; ++i) {
+      v += windows[i].volume();
+    }
+    return v;
+  }
